<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="#666"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health and Wellness App"
            android:textSize="30sp"
            android:textColor="#4E27B0"
            android:id="@+id/title"
            android:textAlignment="center"
            android:layout_marginTop="30dp"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/image2"
            android:scaleType="centerCrop"
            android:layout_margin="30dp"
            android:id="@+id/image"

            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Healthy Recipies"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/recipies"

            />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Nutrition Advice"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/nutrition"

            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:textSize="20dp"
            android:text="Meditation"
            android:fontFamily="sans-serif-condensed-light"
            android:id="@+id/meditation"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Hydration Alert"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/hydartion"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Start Exercise"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/exercise"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Daily Motivation"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/motivation"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Weekly Goals"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/goals"
            />


        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="Check Progress"
            android:fontFamily="sans-serif-condensed-light"
            android:textSize="20dp"
            android:id="@+id/progress"
            />





    </LinearLayout>

</ScrollView>